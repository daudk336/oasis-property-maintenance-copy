{
  "name": "Review",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "description": "Related job id"
    },
    "client_name": {
      "type": "string",
      "description": "Client name"
    },
    "service": {
      "type": "string",
      "description": "Service that was performed"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Star rating 1-5"
    },
    "comment": {
      "type": "string",
      "description": "Optional feedback comment"
    }
  },
  "required": [
    "rating"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}